@model Producto
@{
    var esNuevo = Model.IdProducto == 0;
}

<div asp-validation-summary="ModelOnly" role="alert"></div>

<div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
        <label asp-for="Nombre" class="etiqueta"></label>
        <input asp-for="Nombre" class="campo" required maxlength="120" autofocus />
        <span asp-validation-for="Nombre" class="campo-error"></span>
    </div>
    <div class="sm:col-span-2">
        <label asp-for="Descripcion" class="etiqueta"></label>
        <textarea asp-for="Descripcion" class="campo" rows="2" maxlength="500"></textarea>
        <span asp-validation-for="Descripcion" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="Categoria" class="etiqueta"></label>
        <input asp-for="Categoria" class="campo" required maxlength="60" list="categorias" />
        <datalist id="categorias">
            @foreach (var c in (List<string>)(ViewBag.Categorias ?? new List<string>()))
            {
                <option value="@c"></option>
            }
        </datalist>
        <span asp-validation-for="Categoria" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="UnidadMedida" class="etiqueta"></label>
        <input asp-for="UnidadMedida" class="campo" required maxlength="30" />
        <span asp-validation-for="UnidadMedida" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="PrecioCompra" class="etiqueta"></label>
        <input asp-for="PrecioCompra" type="number" step="0.01" min="0" class="campo" required inputmode="decimal" />
        <span asp-validation-for="PrecioCompra" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="PrecioVenta" class="etiqueta"></label>
        <input asp-for="PrecioVenta" type="number" step="0.01" min="0.01" class="campo" required inputmode="decimal" />
        <span asp-validation-for="PrecioVenta" class="campo-error"></span>
    </div>
    @if (esNuevo)
    {
        <div>
            <label asp-for="Existencia" class="etiqueta">Existencia inicial</label>
            <input asp-for="Existencia" type="number" step="1" min="0" class="campo" required inputmode="numeric" />
            <span asp-validation-for="Existencia" class="campo-error"></span>
        </div>
    }
    else
    {
        <div>
            <label asp-for="Estado" class="etiqueta"></label>
            <select asp-for="Estado" class="campo" asp-items="Html.GetEnumSelectList<EstadoRegistro>()"></select>
        </div>
        <p class="self-end text-sm text-slate-500">Existencia actual: <strong>@Model.Existencia</strong>. Para cambiarla usa “Registrar movimiento”.</p>
    }
</div>

<div class="mt-6 flex flex-wrap justify-end gap-3">
    <a asp-action="Index" class="btn-secundario">Cancelar</a>
    <button type="submit" data-cargando="Guardando..." class="btn-primario">Guardar producto</button>
</div>
