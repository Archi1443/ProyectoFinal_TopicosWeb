@model Cliente
@{
    var esNuevo = Model.IdCliente == 0;
}

<div asp-validation-summary="ModelOnly" role="alert"></div>

<div class="grid gap-5 sm:grid-cols-3">
    <div>
        <label asp-for="Nombre" class="etiqueta"></label>
        <input asp-for="Nombre" class="campo" required maxlength="80" autofocus />
        <span asp-validation-for="Nombre" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="ApellidoPaterno" class="etiqueta"></label>
        <input asp-for="ApellidoPaterno" class="campo" required maxlength="80" />
        <span asp-validation-for="ApellidoPaterno" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="ApellidoMaterno" class="etiqueta"></label>
        <input asp-for="ApellidoMaterno" class="campo" maxlength="80" />
        <span asp-validation-for="ApellidoMaterno" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="Telefono" class="etiqueta"></label>
        <input asp-for="Telefono" type="tel" class="campo" required maxlength="20" />
        <span asp-validation-for="Telefono" class="campo-error"></span>
    </div>
    <div class="sm:col-span-2">
        <label asp-for="Correo" class="etiqueta"></label>
        <input asp-for="Correo" type="email" class="campo" required maxlength="120" />
        <span asp-validation-for="Correo" class="campo-error"></span>
    </div>
    <div class="sm:col-span-2">
        <label asp-for="Direccion" class="etiqueta"></label>
        <input asp-for="Direccion" class="campo" required maxlength="200" />
        <span asp-validation-for="Direccion" class="campo-error"></span>
    </div>
    <div>
        <label asp-for="RFC" class="etiqueta">RFC (opcional)</label>
        <input asp-for="RFC" class="campo uppercase" maxlength="13" />
        <span asp-validation-for="RFC" class="campo-error"></span>
    </div>
    @if (!esNuevo)
    {
        <div>
            <label asp-for="Estado" class="etiqueta"></label>
            <select asp-for="Estado" class="campo" asp-items="Html.GetEnumSelectList<EstadoRegistro>()"></select>
        </div>
    }
</div>

<div class="mt-6 flex flex-wrap justify-end gap-3">
    <a asp-action="Index" class="btn-secundario">Cancelar</a>
    <button type="submit" data-cargando="Guardando..." class="btn-primario">Guardar cliente</button>
</div>
