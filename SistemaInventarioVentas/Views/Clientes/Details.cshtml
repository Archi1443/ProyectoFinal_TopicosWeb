@model Cliente
@{
    ViewData["Title"] = Model.NombreCompleto;
    var ventas = (List<Venta>)ViewBag.Ventas;
    var totalComprado = ventas.Where(v => v.Estado == EstadoVenta.Completada).Sum(v => v.Total);
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
        <a asp-action="Index" class="text-sm text-accion-600 hover:underline">&larr; Clientes</a>
        <h1 class="titulo-pagina">@Model.NombreCompleto</h1>
    </div>
    <a asp-controller="Ventas" asp-action="Create" asp-route-idCliente="@Model.IdCliente" class="btn-primario">Nueva venta</a>
</div>

<div class="grid gap-6 lg:grid-cols-3">
    <section class="card card-cuerpo">
        <dl class="space-y-3 text-sm">
            <div><dt class="text-slate-500">Teléfono</dt><dd class="font-medium">@Model.Telefono</dd></div>
            <div><dt class="text-slate-500">Correo</dt><dd class="font-medium">@Model.Correo</dd></div>
            <div><dt class="text-slate-500">Dirección</dt><dd class="font-medium">@Model.Direccion</dd></div>
            <div><dt class="text-slate-500">RFC</dt><dd class="font-medium">@(Model.RFC ?? "—")</dd></div>
            <div><dt class="text-slate-500">Estado</dt><dd><span class="@(Model.Estado == EstadoRegistro.Activo ? "insignia-verde" : "insignia-gris")">@Model.Estado</span></dd></div>
            <div><dt class="text-slate-500">Total comprado</dt><dd class="text-2xl font-bold text-marino-800">@totalComprado.ToString("C")</dd></div>
        </dl>
    </section>

    <section class="card lg:col-span-2">
        <div class="border-b border-slate-100 px-5 py-4"><h2 class="font-semibold">Historial de compras</h2></div>
        @if (ventas.Count == 0)
        {
            <div class="estado-vacio">Este cliente todavía no tiene compras.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="tabla">
                    <thead><tr><th>Folio</th><th>Fecha</th><th>Pago</th><th>Estado</th><th class="text-right">Total</th></tr></thead>
                    <tbody>
                    @foreach (var v in ventas)
                    {
                        <tr>
                            <td><a asp-controller="Ventas" asp-action="Details" asp-route-id="@v.IdVenta" class="font-semibold text-accion-600 hover:underline">#@v.IdVenta</a></td>
                            <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@v.MetodoPago</td>
                            <td><span class="@(v.Estado == EstadoVenta.Completada ? "insignia-verde" : "insignia-roja")">@v.Estado</span></td>
                            <td class="text-right font-medium">@v.Total.ToString("C")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
